{
  "manifest_version": 3,
  "name": "ZapFilter - Filtros Rápidos WhatsApp Web",
  "version": "1.0.0",
  "description": "Filtros rápidos e inteligentes para WhatsApp Web: Não Lidos, Grupos, Contatos/Privados e mais.",
  "author": "Antigravity & Pair Developer",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ZapFilter - Configurações",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
